<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/styles/main-interface.css" />
  </head>
  <body>
    <!--TOP BAR-->
    <div class="top-bar px-8 py-4 flex flex-row gap-5">
      <h1 class="font-bold">Quote System</h1>
    </div>

    <!--MAIN SECTION-->
    <div class="flex">
      <!--QUOTE LIST-->
      <div class="quote-list p-8 flex-grow">

        <dialog id="create-quote" class="inset-0 m-auto p-6 rounded-md min-w-md">
          <h2 class="mb-4 font-bold text-lg">Create Quote</h2>
          <form action="/quotes" method="POST">
            <div class="flex flex-col gap-2 mb-6">
              <fieldset class="fieldset">
                <legend class="fieldset-legend">Description</legend>
                <input
                  type="text"
                  id="description"
                  name="description"
                  class="input w-full"
                  />
              </fieldset>

              <fieldset class="fieldset">
                <legend class="fieldset-legend">Customer</legend>
                <select name="customer" id="customer-select" class="select w-full">
                  <option value="1">Nick Iacullo</option>
                </select>
              </fieldset>
            </div>
            <div class="flex gap-2 justify-end">
              <button commandfor="create-quote" command="close" type="button" class="btn">Cancel</button>
              <button id="submitQuote" type="submit" class="btn btn-primary">Submit</button> 
            </div> 
          </form>

        </dialog>
        
        <div class="flex justify-between">
        <form action="/quotes" method="GET" class="flex gap-2 mb-2">
          <input
            type="text"
            id="search"
            name="search"
            placeholder="Search Quotes"
            class="input"
          />

          <button id="searchQuotes" type="submit" class="btn">Search</button>
        </form>
        <button command="show-modal" commandfor="create-quote" class="btn btn-soft btn-primary mb-4">Create Quote</button>
        </div>
        <div class="overflow-x-auto">
          <table class="table">
            <colgroup>
              <col style="width: 0" />
              <col />
              <col />
              <col />
              <col style="width: 0" />
            </colgroup>

            <thead>
              <tr class="rounded-box">
                <th>Quote Id</th>
                <th>Description</th>
                <th>Customer</th>
                <!-- <th>Price</th> -->
                <!-- <th>Associate</th> -->
                <th>Status</th>
                <th>View</th>
              </tr>

              <% quotes.forEach(function(quote){ %>
              <tr class="<%= quote == selectedQuote ? "bg-base-200" : "" %>">
                <td><%= quote.id %></td>
                <td><%= quote.description %></td>
                <td><%= quote.customer.name %></td>
                <!-- <td>$<%= quote.price %></td> -->
                <!-- <td><%= quote.associate %></td> -->
                <td><%= quote.status %></td>
                <td class="text-center">
                  <a
                      class="btn btn-sm"
                      href="<%= (() => {
                        const params = new URLSearchParams();
                        for (const [name, value] of Object.entries(req.query)) {
                          params.set(name, value);
                        }
                        params.set("id", quote.id);
                        return "?" + params.toString();
                      })() %>"
                      <% if (selectedQuote) { %>
                      onclick="
                        event.preventDefault();
                        const params = new URLSearchParams(window.location.search);
                        params.set('id', '<%= quote.id %>')
                        window.location.replace('?' + params.toString());
                      "
                      <% } %>
                    >View</a>
                </td>
              </tr>
              <% }); %>
            </thead>
          </table>
        </div>
      </div>


      <% if (selectedQuote) { %>
      <!--DIVIDER-->
      <div class="vl"></div>
      
      <!--QUOTE VIEW-->
      <div class="p-8 flex flex-col flex-grow">
        <div class="mb-4">
          <h2 class="font-bold text-lg">
            Quote #
            <%= selectedQuote.id %>
          </h2>
          <div class="divider"></div>
        </div>

        <div class="quote-details mb-20">
          <div class="customer-details">
            <ul>
              <li><%= selectedQuote.customer.name %></li>
              <li>Customer Phone #</li>
              <li><%= selectedQuote.customer.email %></li>
              <li><%= selectedQuote.customer.address %></li>
            </ul>
          </div>

          <div class="line-items mb-4">
            <table>
              <colgroup>
                <col style="width: 10%" />
                <col style="width: 70%" />
                <col style="width: 20%" />
              </colgroup>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Line Item</th>
                  <th>Price</th>
                </tr>
              </thead>

              <% for (const lineitem of selectedQuote.lineitems) { %>
              <tr>
                <td><%= lineitem.id%></td>
                <td><%= lineitem.description %></td>
                <td><%= lineitem.price %></td>
                <td>
                  <form action="/quotes/<%= selectedQuote.id %>/remove-lineitem" method="POST">
                    <input type="hidden" name="lineItemId" value="<%= lineitem.id %>">
                    <input type="hidden" name="quoteId" value="<%= selectedQuote.id %>">
                    <button type="submit">Delete</button>
                  </form>
                </td>
              </tr>
              <% } %>
            </table>
          </div>

          <button command="show-modal" commandfor="add-lineitem" class="btn mb-4">Add Line Item</button>

          <dialog id="add-lineitem" class="inset-0 m-auto p-6 rounded-md min-w-md">
            <h2 class="mb-4 font-bold text-lg">Add Line Item</h2>
            <form action="/quotes/<%= selectedQuote.id %>/add-lineitem" method="POST">
              <div class="flex flex-col gap-2 mb-6">
                <fieldset class="fieldset">
                  <legend class="fieldset-legend">Description</legend>
                  <input
                    type="text"
                    id="description"
                    name="description"
                    class="input w-full"
                    required
                    />
                 </fieldset>

                <fieldset class="fieldset">
                  <legend class="fieldset-legend">Price</legend>
                  <input
                    type="number"
                    id="price"
                    name="price"
                    class="input validator w-full"
                    required
                    />
                </fieldset>
              </div>
              <div class="flex gap-2 justify-end">
                <button commandfor="add-lineitem" command="close" type="button" class="btn">Cancel</button>
                <button id="submitLineItem" type="submit" class="btn btn-primary">Submit</button>
              </div>
            </form>
          </dialog>

          <div class="notes">
            <div id="notes" class="px-4 py-4">
              <h2 class="font-semibold">Notes</h2>
            </div>
              <ul class="px-4 py-3">
                <% for (const note of selectedQuote.notes) { %>
                  <li><%= note.description %></li>
                <% } %>
              </ul>
          </div>

          <button command="show-modal" commandfor="add-note" class="btn mb-4">Add Note</button>
          <dialog id="add-note" class="inset-0 m-auto p-6 rounded-md min-w-md">
            <h2 class="mb-4 font-bold text-lg">Add Note</h2>
            <form action="/quotes/<%= selectedQuote.id %>/add-note" method="POST">
              <div class="flex flex-col gap-2 mb-6">
              <input
                type="text"
                id="description"
                name="description"
                class="input w-full"
                />
              </div>
              <div class="flex gap-2 justify-end">
                <button commandfor="add-note" command="close" type="button" class="btn">Cancel</button>
                <button id="submitNote" type="submit" class="btn btn-primary">Submit</button>
              </div>
            </form>
          </dialog>

          <div class="finalize">
            <form action="/quotes/<%= selectedQuote.id %>/finalize" method="POST">
              <button id="finalizeQuote" type="submit" class="btn">Finalize Quote</button>
            </form>
            <p>Finalized: <%= selectedQuote.is_finalized %></p>
          </div>

          <div class="price">
            <div id="price">
              <h2>
                <span class="font-semibold">Total: </span>
                <span>
                  $<%= selectedQuote.lineitems.reduce((acc, item) => acc +
                  item.price, 0) %>
                </span>
              </h2>
              <hr />
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </body>
</html>
